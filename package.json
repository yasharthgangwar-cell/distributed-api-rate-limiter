{
  "name": "api-rate-limiter",
  "version": "1.0.0",
  "description": "Production-quality API Rate Limiter Service using Node.js, Express, Redis (Token Bucket + Sliding Window)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "keywords": [
    "rate-limiter",
    "token-bucket",
    "sliding-window",
    "redis",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "verbose": true
  },
  "nodemonConfig": {
    "watch": [
      "src/"
    ],
    "ext": "js,json",
    "ignore": [
      "tests/",
      "node_modules/"
    ]
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "redis": "^5.11.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
